# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Required for AI answering. Without it the tool still works, but answers are
# assembled directly from the knowledge base instead of being synthesised.
GROQ_API_KEY=

# Model used for answering. Any Groq chat model that supports JSON mode.
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated models to fall back to if the primary one is unavailable.
GROQ_FALLBACK_MODELS=llama-3.1-8b-instant

# HTTP port.
PORT=3000

# Traffic controls. When any of these trip, callers get the
# "please try again in about 1 minute" response instead of an error.
RATE_LIMIT_PER_MINUTE=10
GLOBAL_RATE_LIMIT_PER_MINUTE=120
MAX_CONCURRENT_REQUESTS=6
